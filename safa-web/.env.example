# ---- Database (Neon Postgres) ----
# From your Neon dashboard -> Connection string (use the "pooled" URL).
# `pgbouncer=true` is REQUIRED on Neon's pooled endpoint so Prisma disables
# prepared statements (PgBouncer transaction-mode pooling doesn't support
# them). This is what everyday queries (findFirst, findMany, update, ...)
# should go through.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-PROJECT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require&pgbouncer=true"

# DIRECT (non-pooled) connection — same host as above MINUS the "-pooler"
# segment, and no pgbouncer param. REQUIRED separately from DATABASE_URL:
# PgBouncer transaction-mode pooling can route different statements inside
# one Prisma interactive transaction ($transaction(async (tx) => ...)) to
# different physical backend connections, which breaks the transaction with
# Prisma error P2028 ("Transaction not found ... refers to an old closed
# transaction"). lib/prisma.ts's withTransactionRetry() uses THIS url
# specifically to avoid that — confirmed live, this was the actual cause of
# P2028 failures on /api/projects/[id]/select and friends, not a connection
# blip. Also used by `prisma migrate`/`prisma db push` as Prisma's own
# `directUrl` datasource field.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@YOUR-PROJECT.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# ---- Auth ----
NEXTAUTH_URL="http://localhost:3000"
# Generate one:  openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_YOUR_OWN_GENERATED_SECRET"

# ---- Google sign-in (optional; leave blank to hide the Google button) ----
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ---- Stripe (Part 4) ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."          # from `stripe listen` or the dashboard webhook
STRIPE_PRICE_PLUS="price_..."              # Stripe Price ID for the Plus plan
STRIPE_PRICE_PRO="price_..."               # Stripe Price ID for the Pro plan

# ---- Admin (comma-separated; any @safa.ai email is also admin) ----
ADMIN_EMAILS="you@safa.ai"

# ---- Email (optional; Resend). If blank, emails are logged to the console instead. ----
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
EMAIL_FROM="safa.ai <onboarding@resend.dev>"

# ---- Cron auth (pre-launch ops automation, 2026-08-07) ----
# Vercel Cron automatically sends `Authorization: Bearer $CRON_SECRET` on every
# scheduled invocation once this is set as a real env var on the Vercel
# project — verify this against Vercel's current cron docs at deploy time.
# Without it, /api/cron/* routes reject every request (fail closed).
CRON_SECRET="YOUR_RANDOM_CRON_SECRET"
